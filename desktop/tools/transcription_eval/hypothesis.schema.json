{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cepessa.local/schemas/transcription-eval-hypothesis-v1.json",
  "title": "Cepessa transcription hypothesis JSONL record",
  "type": "object",
  "additionalProperties": false,
  "required": ["clip_id", "source_sha256", "system", "segments"],
  "properties": {
    "clip_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string"},
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "model", "model_sha256", "config_sha256"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_ms": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_ms", "end_ms", "speaker_id", "text"],
        "properties": {
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "exclusiveMinimum": 0},
          "speaker_id": {"type": "string", "minLength": 1},
          "person_id": {"type": ["string", "null"]},
          "text": {"type": "string"},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "source_track": {"enum": ["microphone", "system", "mixed"]}
        }
      }
    }
  }
}
