{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cepessa.local/schemas/transcription-eval-corpus-v1.json",
  "title": "Cepessa protected transcription corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "inventory_mode",
    "source",
    "files",
    "summary",
    "selection",
    "manifest_sha256"
  ],
  "properties": {
    "manifest_version": {"const": 1},
    "inventory_mode": {"enum": ["metadata", "hash"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "root_name"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "root_name": {"type": "string", "minLength": 1}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "mtime_ns", "mode"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "size_bytes": {"type": "integer", "minimum": 0},
          "mtime_ns": {"type": "integer", "minimum": 0},
          "mode": {"type": "integer", "minimum": 0},
          "role": {
            "enum": ["microphone", "system", "mixed", "session_metadata"]
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "total_bytes"],
      "properties": {
        "file_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "seed",
        "unit",
        "split_thresholds",
        "units"
      ],
      "properties": {
        "algorithm": {"const": "sha256-unit-v1"},
        "seed": {"type": "string"},
        "unit": {"const": "first_path_component"},
        "split_thresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "upper_bound"],
            "properties": {
              "name": {"enum": ["development", "locked", "stress"]},
              "upper_bound": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
            }
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit_id",
              "selector_hash",
              "selector_value",
              "suggested_split",
              "file_count",
              "total_bytes"
            ],
            "properties": {
              "unit_id": {"type": "string", "minLength": 1},
              "selector_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "selector_value": {"type": "number", "minimum": 0, "maximum": 1},
              "suggested_split": {"enum": ["development", "locked", "stress"]},
              "file_count": {"type": "integer", "minimum": 0},
              "total_bytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"inventory_mode": {"const": "hash"}}},
      "then": {
        "properties": {
          "files": {
            "items": {"required": ["sha256"]}
          }
        }
      }
    }
  ]
}
